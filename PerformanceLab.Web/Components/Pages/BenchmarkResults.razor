@using System.Globalization
@using PerformanceLab.Web.Models
@if (Result != null)
{
    <div class="card mt-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span>📊 Resultados do Benchmark</span>
            <button class="btn btn-sm btn-light" @onclick="CloseHandler">✕</button>
        </div>
        <div class="card-body">
            @if (Result.Recommendations != null)
            {
                <div class="alert alert-info">
                    @Result.Recommendations.Tip
                    <br />
                    <strong>GC Gen0 Collections:</strong> @Result.Recommendations.Gen0Collections
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <strong>Recomendação:</strong> Não disponível
                </div>
            }
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Método</th>
                        <th>Média (ms)</th>
                        <th>Desvio</th>
                        <th>Memória</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (BenchmarkReportDto report in Result.Reports)
                    {
                        <tr>
                            <td>@report.DisplayInfo</td>
                            <td>@(report.Mean?.ToString("N2", new CultureInfo("pt-BR")) ?? "-")</td>
                            <td>@(report.StandardDeviation?.ToString("N2", new CultureInfo("pt-BR")) ?? "-")</td>
                            <td>@FormatMemory(report.AllocatedMemory)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public BenchmarkResultDto? Result { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task CloseHandler()
    {
        await OnClose.InvokeAsync();
    }

    private string FormatMemory(object? allocatedMemory)
    {
        if (allocatedMemory == null) return "-";

        if (!double.TryParse(allocatedMemory.ToString(), out double bytes))
            return allocatedMemory.ToString() ?? "-";

        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        while (bytes >= 1024 && order < sizes.Length - 1)
        {
            order++;
            bytes /= 1024;
        }

        return $"{bytes:N2} {sizes[order]}";
    }
}