@page "/Dashboard"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject SweetAlertService Swal
@inject IDashboardService DashboardService

<div></div>
<div class="container-fluid mt-4">
    <div class="row mt-2">
        <div class="col-12">
            <div class="alert @(DashboardService.IsConnected ? "alert-success" : "alert-warning")">
                Status: @_statusMessage
            </div>
        </div>
    </div>

    <!-- Metric Cards with Gray Border -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="p-3 border border-secondary rounded" style="background-color: #f8f9fa;">
                <div class="row">
                    <div class="col-md-3">
                        <div class="card bg-light">
                            <div class="card-header">GC Mode</div>
                            <div class="card-body">
                                <h6>@DashboardService.CurrentMetrics?.GcMode</h6>
                                <h6>Latency: @DashboardService.CurrentMetrics?.GcLatencyMode</h6>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card bg-light">
                            <div class="card-header">CPU</div>
                            <div class="card-body">
                                <h6>@DashboardService.CurrentMetrics?.CpuUsagePercent %</h6>
                                <h6>Workload: @DashboardService.CurrentMetrics?.ThreadCount threads</h6>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card bg-light">
                            <div class="card-header">Memória RAM (Managed)</div>
                            <div class="card-body">
                                <h6>@DashboardService.CurrentMetrics?.MemoryUsedMB/@DashboardService.CurrentMetrics?.ManagedMemoryMB
                                    MB</h6>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card bg-light">
                                <div class="card-header">GC Collections</div>
                                <div class="card-body">
                                    <h6>Gen0: @DashboardService.CurrentMetrics?.Gen0Collections</h6>
                                    <h6>Gen1: @DashboardService.CurrentMetrics?.Gen1Collections</h6>
                                    <h6>Gen2: @DashboardService.CurrentMetrics?.Gen2Collections</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfico (Chart.js) e Botões lado a lado -->
        <div class="row mt-4">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">Histórico de Memória (últimos 100 ticks)</div>
                    <div class="card-body">
                        <canvas id="memoryChart" height="125"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <!-- Botões Empilhados -->
                <div class="row g-2">
                    <div class="col-12">
                        <div class="p-3 bg-light border border-secondary rounded"
                             style="background-color: #f8f9fa !important; height: 100%;">
                            <div class="text-center text-secondary fw-bold mb-2"
                                 style="font-size: 0.9rem; color: #6c757d !important;">
                                Executar Benchmark (antes/depois)
                            </div>
                            <button id="runBenchmarkBtn" class="btn btn-outline-dark btn-md w-100 mb-1"
                                    @onclick="RunBenchmark" disabled="@_isBenchmarkRunning">
                                OK
                            </button>
                            <button id="stopBenchmarkBtn" class="bbtn btn-outline-dark btn-md w-100 mb-1"
                                    @onclick="CancelBenchmark" disabled="@(!_isBenchmarkRunning)">
                                ⏹ Parar
                            </button>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-light border border-secondary rounded"
                             style="background-color: #f8f9fa !important; height: 100%;">
                            <div class="text-center text-secondary fw-bold mb-2"
                                 style="font-size: 0.9rem; color: #6c757d !important;">
                                Simular Memory Leak (5MB)
                            </div>
                            <button class="btn btn-outline-dark btn-md w-100 mb-1" @onclick="SimulateMemoryLeak"
                                    disabled="@(!_isCleanButtonDisabled)">
                                OK
                            </button>
                            <button class="btn btn-outline-dark btn-md w-100 mb-1" @onclick="CleanMemoryLeak"
                                    disabled="@_isCleanButtonDisabled">
                                Limpar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Benchmark Results Modal -->
        @if (_benchmarkResult != null)
        {
            <BenchmarkResults Result="@_benchmarkResult" OnClose="() => { _benchmarkResult = null; }" />
        }
        @if (_isBenchmarkRunning)
        {
            <div class="container-fluid mt-4">
                <div class="row mt-2">
                    <div class="col-12">
                        <div class="alert alert-info">
                            Benchmark em execução. Aguardando resultados...
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

@code {

    private string _statusMessage = "Aguardando conexão...";
    private bool _chartInitialized = false;
    private DotNetObjectReference<Dashboard>? _objRef;
    private BenchmarkResultDto? _benchmarkResult;
    private bool _isBenchmarkRunning = false;
    private bool _isCleanButtonDisabled = true;


    protected override async Task OnInitializedAsync()
    {
        // Subscribe to service events
        DashboardService.OnConnectionStatusChanged += (isConnected, message) =>
        {
            _statusMessage = message;
            StateHasChanged();
        };
        DashboardService.OnMetricsReceived += (metrics) =>
                {
                    _ = UpdateChartAsync();
                    StateHasChanged();
                };
        DashboardService.OnHistoryReceived += (history) =>
                {
                    _ = UpdateChartAsync();
                    StateHasChanged();
                };
        DashboardService.OnBenchmarkRunningChanged += (isRunning) =>
        {
            _isBenchmarkRunning = isRunning;
            StateHasChanged();
        };

        DashboardService.OnBenchmarkResultReceived += (result) =>
        {
            _benchmarkResult = result;
            StateHasChanged();
        };

        // Initialize the service
        await DashboardService.InitializeAsync(Navigation);

        // Set initial button state
        _isCleanButtonDisabled = DashboardService.IsCleanButtonDisabled;
    }

    [JSInvokable]
    private async Task UpdateChartAsync()
    {
        if (!_chartInitialized || DashboardService.History.Count == 0) return;

        try
        {
            var labels = DashboardService.History.Select((_, i) => i.ToString()).ToArray();
            var memoryData = DashboardService.History.Select(m => (double)m.MemoryUsedMB).ToArray();
            var cpuData = DashboardService.History.Select(m => (double)m.CpuUsagePercent).ToArray();

            await JSRuntime.InvokeVoidAsync("updateMemoryChart", labels, memoryData, cpuData);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error updating chart: {ex.Message}");
        }
    }

    private async Task RunBenchmark()
    {
        try
        {
            await DashboardService.RunBenchmarkAsync();
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Benchmark em Execução",
                Text = "O benchmark está rodando em background. Aguarde ou cancele.",
                Icon = SweetAlertIcon.Info,
                Timer = 3000
            });
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Erro",
                Text = ex.Message,
                Icon = SweetAlertIcon.Error,
                Timer = 3000
            });
        }
    }

    private async Task SimulateMemoryLeak()
    {
        try
        {
            await DashboardService.SimulateMemoryLeakAsync(5);
            _isCleanButtonDisabled = false;
            StateHasChanged();

            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "",
                Text = "Memory leak simulado (5MB)",
                Icon = SweetAlertIcon.Info,
                ShowCancelButton = false,
                ConfirmButtonText = "Ok"
            });
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Erro",
                Text = ex.Message,
                Icon = SweetAlertIcon.Error,
                ShowCancelButton = false,
                ConfirmButtonText = "Ok"
            });
        }
    }

    // iberar recursos quando o componente for descartado
    public async ValueTask DisposeAsync()
    {
        await DashboardService.DisposeAsync();
    }

    private async Task CleanMemoryLeak()
    {
        try
        {
            await DashboardService.CleanMemoryLeakAsync();
            _isCleanButtonDisabled = true;
            StateHasChanged();

            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "",
                Text = "Memory Leak Stopped!",
                Icon = SweetAlertIcon.Info,
                ShowCancelButton = false,
                ConfirmButtonText = "Ok"
            });
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Erro",
                Text = ex.Message,
                Icon = SweetAlertIcon.Error,
                ShowCancelButton = false,
                ConfirmButtonText = "Ok"
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeChartAsync();
        }
    }
    private async Task InitializeChartAsync()
    {
        try
        {
            _objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initializeMemoryChart", _objRef);
            _chartInitialized = true;

            if (DashboardService.History.Count > 0)
            {
                await UpdateChartAsync();
            }

            Console.WriteLine("✅ Gráfico inicializado com sucesso");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Erro ao inicializar gráfico: {ex.Message}");
        }
    }

    private async Task CancelBenchmark()
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            "Tem certeza que deseja cancelar o benchmark em execução?");

        if (!confirm) return;

        try
        {
            await DashboardService.CancelBenchmarkAsync();
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Cancelamento Solicitado",
                Text = "Cancelando benchmark...",
                Icon = SweetAlertIcon.Warning,
                Timer = 3000
            });
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Erro",
                Text = ex.Message,
                Icon = SweetAlertIcon.Error,
                Timer = 3000
            });
        }
    }
}
