@page "/Dashboard"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject SweetAlertService Swal



<div class="container-fluid mt-4">
    <div class="row mt-2">
        <div class="col-12">
            <div class="alert @(_isConnected ? "alert-success" : "alert-warning")">
                Status: @_statusMessage
            </div>
        </div>
    </div>
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card bg-light">
                <div class="card-header">GC Mode</div>
                <div class="card-body">
                    <h5>@_currentMetrics?.GcMode</h5>
                    <h5>Latency: @_currentMetrics?.GcLatencyMode</h5>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-light">
                <div class="card-header">CPU</div>
                <div class="card-body">
                    <h3>@_currentMetrics?.CpuUsagePercent %</h3>
                    <h5>Workload: @_currentMetrics?.ThreadCount threads</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-light">
                <div class="card-header">Memória RAM (Managed)</div>
                <div class="card-body">
                    <h3>@_currentMetrics?.MemoryUsedMB/@_currentMetrics?.ManagedMemoryMB MB</h3>
                </div>
            </div>
        </div>

        

        <div class="col-md-3">
            <div class="card bg-light">
                <div class="card-header">GC Collections</div>
                <div class="card-body">
                    <h6>Gen0: @_currentMetrics?.Gen0Collections</h6>
                    <h6>Gen1: @_currentMetrics?.Gen1Collections</h6>
                    <h6>Gen2: @_currentMetrics?.Gen2Collections</h6>
                </div>
            </div>
        </div>


    </div>

   

    

    <!-- Gráfico (Chart.js) -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">Histórico de Memória (últimos 100 ticks)</div>
                <div class="card-body">
                    <canvas id="memoryChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    
    <!-- Botões -->
    <div class="row mt-4">
        <div class="col-4">
            <div class="p-3 bg-light border border-secondary rounded" style="background-color: #f8f9fa !important;">
                <div class="text-center text-secondary fw-bold mb-2"
                     style="font-size: 0.9rem; color: #6c757d !important;">
                    Executar Benchmark (antes/depois)
                </div>
                <button class="btn btn-primary btn-md w-100" @onclick="RunBenchmark">
                    OK
                </button>
            </div>

        </div>
        <div class="col-4">
            <div class="p-3 bg-light border border-secondary rounded" style="background-color: #f8f9fa !important;">
                <div class="text-center text-secondary fw-bold mb-2"
                     style="font-size: 0.9rem; color: #6c757d !important;">
                    Simular Memory Leak (5MB)
                </div>
                <button class="btn btn-primary btn-md w-100" @onclick="SimulateMemoryLeak">
                    OK
                </button>
            </div>
        </div>
        <div class="col-4">
            <div class="p-3 bg-light border border-secondary rounded" style="background-color: #f8f9fa !important;">
                <div class="text-center text-secondary fw-bold mb-2"
                     style="font-size: 0.9rem; color: #6c757d !important;">
                    Limpar Memory Leak (5MB)
                </div>
                <button class="btn btn-primary btn-md w-100 text-white" @onclick="CleanMemoryLeak"
                        disabled="@_isCleanButtonDisabled">
                    OK
                </button>

            </div>
        </div>
    </div>
    @if (_benchmarkResult != null)
    {
        <BenchmarkResults Result="@_benchmarkResult" OnClose="() => { _benchmarkResult = null; }" />
    }

   
</div>

@code {

    private PerformanceMetrics? _currentMetrics;
    private List<PerformanceMetrics> _history = new();
    private HubConnection? _hubConnection;
    private bool _isConnected = false;
    private string _statusMessage = "Aguardando conexão...";
    HttpClient? httpClient = null;
    private bool _isCleanButtonDisabled = true; // Add this line
    private bool _chartInitialized = false;
    private DotNetObjectReference<DashboardMetrics>? _objRef;
    private BenchmarkResultDto? _benchmarkResult;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("🔵 OnInitializedAsync iniciado");
        // Setup SignalR
        _hubConnection = new HubConnectionBuilder()
                        .WithUrl(Navigation.ToAbsoluteUri("/metricsHub"))
                        .WithAutomaticReconnect()
                        .Build();

        // Status da conexão
        _hubConnection.Closed += (error) =>
        {
            InvokeAsync(() =>
            {
                _isConnected = false;
                _statusMessage = "❌ Desconectado";
                StateHasChanged();
                Console.WriteLine("🔴 SignalR desconectado");
            });
            return Task.CompletedTask;
        };
        _hubConnection.Reconnected += (connectionId) =>
               {
                   InvokeAsync(() =>
                   {
                       _isConnected = true;
                       _statusMessage = $"✅ Reconectado (ID: {connectionId})";
                       StateHasChanged();
                       Console.WriteLine($"🔄 SignalR reconectado: {connectionId}");
                   });
                   return Task.CompletedTask;
               };

        _hubConnection.On<PerformanceMetrics>("ReceiveMetrics", metrics =>
                        {
                            // InvokeAsync muda para a thread do Dispatcher do Blazor
                            InvokeAsync(() =>
                            {
                                _currentMetrics = metrics;

                                // Adicionar ao histórico (limitar a 100 itens)
                                _history.Add(metrics);
                                if (_history.Count > 100)
                                {
                                    _history.RemoveAt(0);
                                }
                                _ = UpdateChartAsync();
                                StateHasChanged();

                                Console.WriteLine($"📊 Métricas recebidas: CPU={metrics.CpuUsagePercent}%, Memória={metrics.MemoryUsedMB}MB");
                            });
                        });

        _hubConnection.On<List<PerformanceMetrics>>("ReceiveHistory", history =>
                {
                    InvokeAsync(() =>
                    {
                        _history = history;
                        _ = UpdateChartAsync();
                        StateHasChanged();
                    });
                });

        try
        {
            await _hubConnection.StartAsync();
            _isConnected = true;
            _statusMessage = "✅ Conectado";
            StateHasChanged();
            Console.WriteLine("✅ Conectado ao MetricsHub");
        }
        catch (Exception ex)
        {
            _statusMessage = $"❌ Erro: {ex.Message}";
            StateHasChanged();
        }

    }
    [JSInvokable]
    private async Task UpdateChartAsync()
    {
        if (!_chartInitialized || _history.Count == 0) return;

        try
        {
            var labels = _history.Select((_, i) => i.ToString()).ToArray();
            var memoryData = _history.Select(m => (double)m.MemoryUsedMB).ToArray();
            var cpuData = _history.Select(m => (double)m.CpuUsagePercent).ToArray();

            await JSRuntime.InvokeVoidAsync("updateMemoryChart", labels, memoryData, cpuData);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error updating chart: {ex.Message}");
            var result = Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Erro",
                Text = ex.Message,
                Icon = SweetAlertIcon.Info,
                ShowCancelButton = false,
                ConfirmButtonText = "Ok"
            });
        }
    }

    private async Task RunBenchmark()
    {
        try
        {
            httpClient = HttpClientFactory.CreateClient("API");

            // Chamar API que executa Benchmark.NET
            var response = await httpClient.PostAsync("/api/benchmark/run", null);

            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();

                _benchmarkResult = JsonSerializer.Deserialize<BenchmarkResultDto>(content, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                
                StateHasChanged();
                @*
                _ = Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "",
                    Text = "Benchmark executado com sucesso",
                    Icon = SweetAlertIcon.Info,
                    ShowCancelButton = false,
                    ConfirmButtonText = "Ok"
                }); *@
                
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"❌ Benchmark falhou: {error}");

                await JSRuntime.InvokeVoidAsync("Swal.fire", new
                {
                    title = "Erro",
                    text = response.StatusCode,
                    icon = "error"
                });

                var result = Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Erro",
                    Text = error,
                    Icon = SweetAlertIcon.Info,
                    ShowCancelButton = false,
                    ConfirmButtonText = "Ok"
                });
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Erro no benchmark: {ex.Message}");

            var result = Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Erro",
                Text = ex.Message,
                Icon = SweetAlertIcon.Info,
                ShowCancelButton = false,
                ConfirmButtonText = "Ok"
            });
            StateHasChanged();
        }
    }

    private async Task SimulateMemoryLeak()
    {
        Console.WriteLine("🔵 SimulateMemoryLeak iniciado");

        try
        {
            Console.WriteLine("📡 Enviando requisição para /api/memory-leak/simulate-leak?mb=5");

            httpClient = HttpClientFactory.CreateClient("API");
            var response = await httpClient.PostAsync("/api/memory-leak/simulate-leak?mb=5", null);

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("✅ Memory leak simulado");

                var message = await response.Content.ReadAsStringAsync();

                
                var result = Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "",
                    Text = message,
                    Icon = SweetAlertIcon.Info,
                    ShowCancelButton = false,
                    ConfirmButtonText = "Ok"
                });
                _isCleanButtonDisabled = false;
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(error))
                {
                    // If no content, use status code and reason
                    error = $"Status Code: {(int)response.StatusCode} - {response.ReasonPhrase}";
                    Console.WriteLine($"⚠️ No error content returned: {error}");

          

                    var result2 = Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Erro",
                        Text = error,
                        Icon = SweetAlertIcon.Info,
                        ShowCancelButton = false,
                        ConfirmButtonText = "Ok"
                    });
                }
                else
                {
                    Console.WriteLine($"❌ Memory leak falhou: {error}");
                }

               

                var result = Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Erro",
                    Text = error,
                    Icon = SweetAlertIcon.Info,
                    ShowCancelButton = false,
                    ConfirmButtonText = "Ok"
                });
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Erro ao simular memory leak: {ex.Message}");

    
            var result = Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Erro",
                Text = ex.Message,
                Icon = SweetAlertIcon.Info,
                ShowCancelButton = false,
                ConfirmButtonText = "Ok"
            });
            StateHasChanged();
        }

    }

    // iberar recursos quando o componente for descartado
    public async ValueTask DisposeAsync()
    {

        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private async Task CleanMemoryLeak()
    {
        httpClient = HttpClientFactory.CreateClient("API");
        await httpClient.PostAsync("/api/memory-leak/clear-leak", null);

        var result = Swal.FireAsync(new SweetAlertOptions
        {
            Title = "",
            Text = "Memory Leak Stopped!",
            Icon = SweetAlertIcon.Info,
            ShowCancelButton = false,
            ConfirmButtonText = "Ok"
        });
        _isCleanButtonDisabled = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeChartAsync();
        }
    }
    private async Task InitializeChartAsync()
    {
        try
        {
            _objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initializeMemoryChart", _objRef);
            _chartInitialized = true;

            // Se já houver dados no histórico, atualiza o gráfico
            if (_history.Count > 0)
            {
                await UpdateChartAsync();
            }

            Console.WriteLine("✅ Gráfico inicializado com sucesso");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Erro ao inicializar gráfico: {ex.Message}");
        }
    }

}
